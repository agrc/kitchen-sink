{
  "name": "@ugrc/kitchen-sink",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/agrc/kitchen-sink.git"
  },
  "license": "MIT",
  "author": "ugrc developers",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "build:storybook": "storybook build --docs --output-dir ./dist --disable-telemetry",
    "check": "tsc -b && prettier . --check",
    "firebase:save-state": "bash ./scripts/firebase-emulators.sh --import ./data/firebase --export-on-exit --only auth",
    "format": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "eslint . --quiet --fix",
    "storybook": "run-p storybook:*",
    "storybook:dev": "storybook dev --port 6006",
    "storybook:firebase": "bash ./scripts/firebase-emulators.sh --import ./data/firebase --only auth",
    "test": "vitest"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-packagejson",
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ],
    "semi": true,
    "singleQuote": true,
    "tailwindFunctions": [
      "clsx",
      "tv",
      "twJoin",
      "twMerge"
    ]
  },
  "dependencies": {
    "@arcgis/core": "5.1.15",
    "@arcgis/map-components": "5.1.15",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-lorem-ipsum": "^1.4.10",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@esri/calcite-components": "5.1.2",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-links": "10.5.5",
    "@storybook/addon-themes": "10.5.5",
    "@storybook/react-vite": "10.5.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@ugrc/eslint-config": "workspace:*",
    "@ugrc/tailwind-preset": "workspace:*",
    "@ugrc/tsconfigs": "workspace:*",
    "@vitejs/plugin-react": "^6.0.5",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.39.4",
    "firebase": "^12.17.0",
    "firebase-tools": "^15.25.1",
    "happy-dom": "^20.11.1",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "read-pkg": "^10.1.0",
    "release-please": "^17.11.1",
    "storybook": "10.5.5",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-react-aria-components": "^2.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
