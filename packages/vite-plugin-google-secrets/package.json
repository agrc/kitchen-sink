{
  "name": "@ugrc/vite-plugin-google-secrets",
  "version": "1.0.0",
  "private": false,
  "description": "Load Google Cloud Secret Manager values into the environment during Vite config.",
  "keywords": [
    "ugrc",
    "vite",
    "vite-plugin",
    "google-cloud",
    "secret-manager"
  ],
  "homepage": "https://github.com/agrc/kitchen-sink/tree/main/packages/vite-plugin-google-secrets",
  "bugs": {
    "url": "https://github.com/agrc/kitchen-sink/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agrc/kitchen-sink.git"
  },
  "license": "MIT",
  "author": "ugrc developers",
  "maintainers": [
    {
      "name": "Steve Gourley",
      "email": "sgourley@utah.gov"
    },
    {
      "name": "Scott Davis",
      "email": "stdavis@utah.gov"
    }
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "tsc --ignoreConfig --noEmit --target ES2022 --module ESNext --moduleResolution Bundler --strict --skipLibCheck src/index.ts src/index.test.ts",
    "prepublish": "cp ../../LICENSE ./LICENSE",
    "test": "vitest --config ../../vite.config.ts"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.4",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
